<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 模板: __USER_HOME__ 由 install.sh 渲染成真实用户目录后再装入 /Library/LaunchDaemons -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xuan.heatsampler</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__USER_HOME__/Library/heat-sampler/sampler.py</string>
        <string>--home</string>
        <string>__USER_HOME__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>120</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardErrorPath</key>
    <string>__USER_HOME__/.cache/heat-sampler/daemon.err.log</string>
    <key>StandardOutPath</key>
    <string>__USER_HOME__/.cache/heat-sampler/daemon.out.log</string>
</dict>
</plist>
